@model IEnumerable<FirstWebMVC.Models.ViewModels.StudentFacultyViewModel>

@{
    ViewData["Title"] = "Danh sách Sinh viên";
}

<h2>Danh sách Sinh viên</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm mới Sinh viên</a>
</p>

<table class="table table-bordered table-hover">
    <thead class="table-primary">
        <tr>
            <th>Mã SV</th>
            <th>Họ và tên</th>
            <th>Tuổi</th>
            <th>Email</th>
            <th>Khoa</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StudentCode</td>
                <td>@item.FullName</td>
                <td>@item.Age</td>
                <td>@item.Email</td>
                <td>@item.FacultyName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.StudentCode" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.StudentCode" class="btn btn-danger btn-sm">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>